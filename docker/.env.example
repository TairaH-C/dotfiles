# docker/.env — machine-local secrets and identity (gitignored).
# Copy this file to docker/.env and fill in what you need:
#
#   cp docker/.env.example docker/.env

# --- API keys (all optional) -------------------------------------------------
# NOTE: if ANTHROPIC_API_KEY is set, Claude Code bills the API key instead of
# your subscription login. Leave it empty to use `claude` interactive login
# (the login state persists in the devenv_home volume).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# --- Personal git identity ---------------------------------------------------
# bootstrap.sh writes these to ~/.gitconfig.local on every container start
# (this file is the source of truth; edits here win after a restart).
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL=you@example.com

# --- Workspace root on the host ----------------------------------------------
# Normally auto-detected by scripts/Start-Docker.ps1 (parent of the dotfiles
# repo). Only set this if you start compose manually from another directory.
# WORKSPACE_ROOT=C:\Users\you\workspace

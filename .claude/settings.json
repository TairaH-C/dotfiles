{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(docker ps *)",
      "Bash(docker volume ls *)",
      "Bash(docker logs devenv *)"
    ],
    "deny": [
      "Read(./docker/.env)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(docker volume prune *)",
      "Bash(docker system prune *)"
    ]
  }
}
